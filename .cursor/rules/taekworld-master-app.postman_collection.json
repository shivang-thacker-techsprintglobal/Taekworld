        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/NewStudent/application/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "NewStudent",
                "application",
                "{{applicationId}}"
              ]
            },
            "description": "StudentApplicationDetailDto; first read marks it viewed."
          }
        },
        {
          "name": "Enroll (not used by app v1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
