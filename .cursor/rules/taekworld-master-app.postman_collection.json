    {
      "name": "3. Applications",
      "item": [
        {
          "name": "List (pending + enrolled)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/NewStudent/applications/{{dojangId}}",
              "host": [
                "{{baseUrl}}"
