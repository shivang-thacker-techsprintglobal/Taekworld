          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json(); const first = (b.pendingApplications||[])[0] || (b.enrolledApplications||[])[0]; if (first) pm.environment.set('applicationId', String(first.id));"
                ]
              }
            }
