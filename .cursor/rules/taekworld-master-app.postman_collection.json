            "description": "App v1 opens https://www.blackbelthw.com/master/newstudent instead. Real side effects ($150 fee flow) - use on UAT only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollmentDate\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
