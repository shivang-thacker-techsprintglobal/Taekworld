                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/TrialMember/enroll/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
